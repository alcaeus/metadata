{
  "name": "alcaeus/metadata",
  "description": "A library to parse and manage metadata",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Braun",
      "email": "work@alcaeus.org"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-mongodb": "^2.1",
    "alcaeus/graph": "*@dev",
    "mongodb/mongodb": "^2.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.4",
    "squizlabs/php_codesniffer": "^3.8",
    "doctrine/coding-standard": "^12.0",
    "phpstan/phpstan": "^2.1.30"
  },
  "autoload": {
    "psr-4": {
      "Alcaeus\\Metadata\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Alcaeus\\Metadata\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
